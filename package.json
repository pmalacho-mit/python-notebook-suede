{
  "name": "python-notebook-suede",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "./sweater-vest-suede/templates/sveltekit/with-exclude-tests-routes-from-build.sh vite build",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "prepare": "svelte-kit sync || echo ''",
    "sync-server": "./src/suede/testyjs-suede/docker/websocket-server/run.sh",
    "report": "./sweater-vest-suede/report.sh --closet /tests --server http://localhost:5173 --forward 5173,1234 --silence 600"
  },
  "dependencies": {
    "@codingame/esbuild-import-meta-url-plugin": "^1.0.3",
    "@codingame/monaco-vscode-files-service-override": "~20.2.1",
    "@codingame/monaco-vscode-python-default-extension": "~20.2.1",
    "@jupyter/ydoc": "^4.1.1",
    "@jupyterlab/nbformat": "^4.5.4",
    "browser-basedpyright": "1.39.10",
    "katex": "^0.16.28",
    "marked": "^17.0.1",
    "monaco-editor": "npm:@codingame/monaco-vscode-editor-api@~20.2.1",
    "monaco-editor-wrapper": "~6.12.0",
    "monaco-languageclient": "~9.11.0",
    "nanoid": "^5.1.6",
    "pyodide": "^0.29.3",
    "vite-plugin-static-copy": "^3.2.0",
    "vscode": "npm:@codingame/monaco-vscode-extension-api@~20.2.1",
    "vscode-languageclient": "~9.0.1",
    "vscode-languageserver-protocol": "~3.17.5",
    "y-monaco": "^0.1.6",
    "y-protocols": "^1.0.6",
    "yjs": "^13.5.40"
  },
  "devDependencies": {
    "@storybook/test": "^8.6.14",
    "@sveltejs/adapter-static": "^3.0.10",
    "@sveltejs/kit": "^2.49.1",
    "@sveltejs/vite-plugin-svelte": "^6.2.1",
    "@tailwindcss/vite": "^4.1.17",
    "@types/dockerode": "^4.0.1",
    "@types/node": "^25.9.1",
    "dockerode": "^5.0.0",
    "dockview": "^4.11.0",
    "dockview-core": "^4.11.0",
    "html-to-image": "^1.11.13",
    "svelte": "^5.45.6",
    "svelte-check": "^4.3.4",
    "tailwindcss": "^4.1.17",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.1",
    "y-websocket": "^3.0.0"
  }
